[Unit]
Description=AgentBus worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/agentbus
ExecStart=/path/to/agentbus/.venv/bin/agentbus worker --config %h/.agentbus/config.toml
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
