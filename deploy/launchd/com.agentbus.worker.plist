<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentbus.worker</string>

  <key>WorkingDirectory</key>
  <string>/path/to/agentbus</string>

  <key>ProgramArguments</key>
  <array>
    <string>/path/to/agentbus/env/bin/agentbus</string>
    <string>worker</string>
    <string>run</string>
    <string>--config</string>
    <string>/Users/user/.agentbus/config.toml</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/user/.agentbus/logs/agentbus-worker.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/user/.agentbus/logs/agentbus-worker.err.log</string>
</dict>
</plist>
